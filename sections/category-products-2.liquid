<section class="category-section">
  <div class="container">
    <div class="category-block">
      <div class="category-sidebar">
        <h2>Consumer electronics</h2>
        <a href="/collections/all" class="explore-link">Explore all</a>
        <img src="https://via.placeholder.com/280x300/E8EEF8/223355?text=Electronics" alt="Electronics">
      </div>
      <div class="products-grid">
        {% for i in (1..8) %}
        <div class="product-card-small">
          <img src="https://via.placeholder.com/120x120/FFFFFF/444444?text=Item+{{i}}" alt="Item">
          <h3>Product name</h3>
          <p>From USD {{ 12 | times:i }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
